# WalletConnect / Reown Cloud project ID, used by RainbowKit for the WalletConnect connector.
# Get one free at https://cloud.reown.com. Optional — RainbowKit falls back to injected-wallet-only
# connectors (e.g. MetaMask) if this is left blank. This is public configuration, not a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
