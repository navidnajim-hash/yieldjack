# Chain the keeper operates on: "anvil" (31337, http://127.0.0.1:8545) or
# "robinhood-testnet" (46630, the RPC below).
KEEPER_NETWORK=anvil

# Robinhood Chain Testnet RPC (only needed when KEEPER_NETWORK=robinhood-testnet).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# The keeper's OWN operational private key, funded with a small amount of testnet ETH for gas.
# This is never the user's wallet key. Never commit a real value here.
KEEPER_PRIVATE_KEY=

# When true, the keeper logs what it *would* do without sending any transaction.
DRY_RUN=true

# How often the keeper polls on-chain state, in milliseconds.
POLL_INTERVAL_MS=15000
